<?xml version="1.0" encoding="UTF-8"?>
<!--
  This site is otherwise pure static HTML/CSS/JS with zero configuration.
  The one thing IIS on Azure App Service needs help with is that .webp is
  not in its default MIME map, so a .webp request 404s even though the
  file exists. This adds only that one mapping; everything else IIS
  already serves correctly on its own.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- remove-then-add is defensive: if some future Azure base image
           already registers .webp, a bare <mimeMap> add would throw a
           500.19 "duplicate mimeMap" error for the WHOLE site, not just
           this file. <remove> is a safe no-op when nothing is registered. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>
</configuration>
