<?xml version="1.0" encoding="UTF-8"?>
<!--
  This site is otherwise pure static HTML/CSS/JS with zero configuration.
  Two things IIS on Azure App Service needs help with:

  1. .webp is not in its default MIME map, so a .webp request 404s even
     though the file exists.
  2. IIS sends no Cache-Control header by default (only ETag), so every
     asset is fully re-fetched on every repeat visit.

  Cache lifetimes below are deliberately short for styles.css and
  main.js (they are hand-edited directly and still change during active
  coursework) and longer for images/ (each file is generated once under
  a descriptive, width-specific name and is not edited in place - a new
  image gets a new filename rather than overwriting an old one).
  HTML pages are left with IIS's default behaviour entirely, so a page
  edit is always visible on the very next request.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- remove-then-add is defensive: if some future Azure base image
           already registers .webp, a bare <mimeMap> add would throw a
           500.19 "duplicate mimeMap" error for the WHOLE site, not just
           this file. <remove> is a safe no-op when nothing is registered. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>

  <location path="styles.css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="main.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="01:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
