<?xml version="1.0" encoding="UTF-8"?>
<!--
  This site is otherwise pure static HTML/CSS/JS with zero configuration.
  Things IIS on Azure App Service needs help with:

  1. .webp is not in its default MIME map, so a .webp request 404s even
     though the file exists.
  2. IIS sends no Cache-Control header by default (only ETag), so every
     asset is fully re-fetched on every repeat visit.

  styles.css/main.js and their minified twins (styles.min.css,
  main.min.js - see docs/tools/minify_assets.py) get a full year of
  Cache-Control, safe only because every HTML page references them
  with a "?v=N" query string bumped by hand whenever either file
  changes (see the comment above the <link>/<script> tags in any page,
  and the checklist on optimization.html under "One tradeoff,
  disclosed rather than hidden"). A query string is a distinct
  browser cache entry even though IIS resolves the physical file
  ignoring it, so bumping the number forces a fresh fetch regardless
  of how long the previous version is still cached somewhere.
  images/ also gets a full year, unconditionally and with no version
  query string needed at all, since each file is generated once under
  a descriptive, width-specific name and is never edited in place - a
  changed image gets a new filename, not an overwrite, so there is
  nothing for a long cache to ever go stale against.
  HTML pages are left with IIS's default behaviour entirely, so a page
  edit is always visible on the very next request.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <!-- remove-then-add is defensive: if some future Azure base image
           already registers .webp, a bare <mimeMap> add would throw a
           500.19 "duplicate mimeMap" error for the WHOLE site, not just
           this file. <remove> is a safe no-op when nothing is registered. -->
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>
  </system.webServer>

  <location path="styles.css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="main.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="styles.min.css">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="main.min.js">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>

  <location path="images">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
